# [
source "$SRC_DIR/scripts/utils/build_utils.sh" || exit 1

SOURCE_FIRMWARE_PATH="$(cut -d "/" -f 1 -s <<< "$SOURCE_FIRMWARE")_$(cut -d "/" -f 2 -s <<< "$SOURCE_FIRMWARE")"
TARGET_FIRMWARE_PATH="$(cut -d "/" -f 1 -s <<< "$TARGET_FIRMWARE")_$(cut -d "/" -f 2 -s <<< "$TARGET_FIRMWARE")"

FIRMWARE_IDENTITY="$(cat \
    "$FW_DIR/$SOURCE_FIRMWARE_PATH/.extracted" \
    "$FW_DIR/$TARGET_FIRMWARE_PATH/.extracted" 2> /dev/null | sha256sum | cut -d " " -f 1)"
if [ -d "$WORK_DIR" ] && \
        { [ ! -f "$WORK_DIR/.firmware_identity" ] || \
            [ "$(cat "$WORK_DIR/.firmware_identity" 2> /dev/null)" != "$FIRMWARE_IDENTITY" ]; }; then
    LOG "- Firmware identity changed; recreating work dir"
    rm -rf "${WORK_DIR:?}"
fi

COPY_SOURCE_FIRMWARE()
{
    local SOURCE_FOLDERS="product system prism optics"
    for f in $SOURCE_FOLDERS; do
        if [ -d "$FW_DIR/$SOURCE_FIRMWARE_PATH/$f" ]; then
            LOG "- Copying /$f from source firmware"
            EVAL "rsync -a --mkpath --delete --exclude=\"*system_ext*\" \"$FW_DIR/$SOURCE_FIRMWARE_PATH/$f\" \"$WORK_DIR\"" || exit 1
            sed "/system_ext/d" "$FW_DIR/$SOURCE_FIRMWARE_PATH/file_context-$f" > "$WORK_DIR/configs/file_context-$f"
            sed "/system_ext/d" "$FW_DIR/$SOURCE_FIRMWARE_PATH/fs_config-$f" > "$WORK_DIR/configs/fs_config-$f"
            if [[ "$f" == "product" ]]; then
                LOG_STEP_IN
                SET_PROP "product" "ro.product.product.name" "$(GET_PROP "$FW_DIR/$TARGET_FIRMWARE_PATH/product/etc/build.prop" "ro.product.product.name")"
                LOG_STEP_OUT
            elif [[ "$f" == "system" ]]; then
                LOG_STEP_IN
                local SOURCE_DEVICE
                SOURCE_DEVICE="$(GET_PROP "$FW_DIR/$SOURCE_FIRMWARE_PATH/odm/etc/build.prop" "ro.product.odm.device")"
                [ ! "$SOURCE_DEVICE" ] && SOURCE_DEVICE="$(GET_PROP "$FW_DIR/$SOURCE_FIRMWARE_PATH/system/system/build.prop" "ro.product.system.device")"
                [ ! "$SOURCE_DEVICE" ] && SOURCE_DEVICE="$(GET_PROP "$FW_DIR/$SOURCE_FIRMWARE_PATH/system/system/build.prop" "ro.product.device")"
                SET_PROP "system" "ro.product.device" "$SOURCE_DEVICE"
                LOG_STEP_OUT
            fi
        else
            [ -d "$WORK_DIR/$f" ] && rm -rf "${WORK_DIR:?}/$f"
            [ -f "$WORK_DIR/configs/file_context-$f" ] && rm -f "$WORK_DIR/configs/file_context-$f"
            [ -f "$WORK_DIR/configs/fs_config-$f" ] && rm -f "$WORK_DIR/configs/fs_config-$f"
        fi
    done

    if [ -d "$FW_DIR/$SOURCE_FIRMWARE_PATH/system_ext" ]; then
        if $TARGET_OS_BUILD_SYSTEM_EXT_PARTITION; then
            LOG_STEP_IN "- Copying /system_ext from source firmware"
            [ -L "$WORK_DIR/system/system_ext" ] && rm -f "$WORK_DIR/system/system_ext"
            [ -d "$WORK_DIR/system/system/system_ext" ] && rm -rf "$WORK_DIR/system/system/system_ext"
            EVAL "rsync -a --mkpath --delete \"$FW_DIR/$SOURCE_FIRMWARE_PATH/system_ext\" \"$WORK_DIR\"" || exit 1
            mkdir -p "$WORK_DIR/system/system_ext"
            EVAL "ln -sf \"/system_ext\" \"$WORK_DIR/system/system/system_ext\"" || exit 1
            SET_METADATA "system" "system_ext" 0 0 755 "u:object_r:system_file:s0"
            SET_METADATA "system" "system/system_ext" 0 0 644 "u:object_r:system_file:s0"
            EVAL "cp -a \"$FW_DIR/$SOURCE_FIRMWARE_PATH/file_context-system_ext\" \"$WORK_DIR/configs/file_context-system_ext\"" || exit 1
            EVAL "cp -a \"$FW_DIR/$SOURCE_FIRMWARE_PATH/fs_config-system_ext\" \"$WORK_DIR/configs/fs_config-system_ext\"" || exit 1
            LOG_STEP_OUT
        else
            LOG_STEP_IN "- Copying /system/system/system_ext from source firmware"
            [ -d "$WORK_DIR/system/system_ext" ] && rm -rf "$WORK_DIR/system/system_ext"
            [ -L "$WORK_DIR/system/system/system_ext" ] && rm -f "$WORK_DIR/system/system/system_ext"
            [ -d "$WORK_DIR/system_ext" ] && rm -rf "$WORK_DIR/system_ext"
            [ -f "$WORK_DIR/configs/file_context-system_ext" ] && rm -f "$WORK_DIR/configs/file_context-system_ext"
            [ -f "$WORK_DIR/configs/fs_config-system_ext" ] && rm -f "$WORK_DIR/configs/fs_config-system_ext"
            EVAL "rsync -a --mkpath --delete \"$FW_DIR/$SOURCE_FIRMWARE_PATH/system_ext\" \"$WORK_DIR/system/system\"" || exit 1
            EVAL "ln -sf \"/system/system_ext\" \"$WORK_DIR/system/system_ext\"" || exit 1
            SET_METADATA "system" "system_ext" 0 0 644 "u:object_r:system_file:s0"
            sed "s/^\/system_ext/\/system\/system_ext/g" "$FW_DIR/$SOURCE_FIRMWARE_PATH/file_context-system_ext" >> "$WORK_DIR/configs/file_context-system"
            sed "s/^system_ext/system\/system_ext/g" "$FW_DIR/$SOURCE_FIRMWARE_PATH/fs_config-system_ext" >> "$WORK_DIR/configs/fs_config-system"
            ADD_TO_WORK_DIR "b0sxxx" "system_ext" "etc/build_flags.json" 0 0 644 "u:object_r:system_file:s0" || exit 1
            DELETE_FROM_WORK_DIR "system" "system/system_ext/etc/NOTICE.xml.gz"
            LOG_STEP_OUT
        fi
    elif [ -d "$FW_DIR/$SOURCE_FIRMWARE_PATH/system/system/system_ext" ]; then
        if $TARGET_OS_BUILD_SYSTEM_EXT_PARTITION; then
            LOG_STEP_IN "- Copying /system_ext from source firmware"
            [ -L "$WORK_DIR/system/system_ext" ] && rm -f "$WORK_DIR/system/system_ext"
            [ -d "$WORK_DIR/system/system/system_ext" ] && rm -rf "$WORK_DIR/system/system/system_ext"
            EVAL "rsync -a --mkpath --delete \"$FW_DIR/$SOURCE_FIRMWARE_PATH/system/system/system_ext\" \"$WORK_DIR\"" || exit 1
            mkdir -p "$WORK_DIR/system/system_ext"
            EVAL "ln -sf \"/system_ext\" \"$WORK_DIR/system/system/system_ext\"" || exit 1
            SET_METADATA "system" "system_ext" 0 0 755 "u:object_r:system_file:s0"
            SET_METADATA "system" "system/system_ext" 0 0 644 "u:object_r:system_file:s0"
            grep -F "system/system_ext" "$FW_DIR/$SOURCE_FIRMWARE_PATH/file_context-system" | sed "s/^\/system//" > "$WORK_DIR/configs/file_context-system_ext"
            grep -F "system/system_ext" "$FW_DIR/$SOURCE_FIRMWARE_PATH/fs_config-system" | sed "s/^system\///" > "$WORK_DIR/configs/fs_config-system_ext"
            sed -i "s/^system_ext /  /g" "$WORK_DIR/configs/fs_config-system_ext"
            ADD_TO_WORK_DIR "b0qxxx" "system_ext" "etc/build_flags.json" 0 0 644 "u:object_r:system_file:s0" || exit 1
            ADD_TO_WORK_DIR "b0qxxx" "system_ext" "etc/NOTICE.xml.gz" 0 0 644 "u:object_r:system_file:s0" || exit 1
            LOG_STEP_OUT
        else
            LOG_STEP_IN "- Copying /system/system/system_ext from source firmware"
            [ -d "$WORK_DIR/system/system_ext" ] && rm -rf "$WORK_DIR/system/system_ext"
            [ -L "$WORK_DIR/system/system/system_ext" ] && rm -f "$WORK_DIR/system/system/system_ext"
            [ -d "$WORK_DIR/system_ext" ] && rm -rf "$WORK_DIR/system_ext"
            [ -f "$WORK_DIR/configs/file_context-system_ext" ] && rm -f "$WORK_DIR/configs/file_context-system_ext"
            [ -f "$WORK_DIR/configs/fs_config-system_ext" ] && rm -f "$WORK_DIR/configs/fs_config-system_ext"
            EVAL "rsync -a --mkpath --delete \"$FW_DIR/$SOURCE_FIRMWARE_PATH/system/system/system_ext\" \"$WORK_DIR/system/system\"" || exit 1
            EVAL "ln -sf \"/system/system_ext\" \"$WORK_DIR/system/system_ext\"" || exit 1
            grep -F "system_ext" "$FW_DIR/$SOURCE_FIRMWARE_PATH/file_context-system" >> "$WORK_DIR/configs/file_context-system"
            grep -F "system_ext" "$FW_DIR/$SOURCE_FIRMWARE_PATH/fs_config-system" >> "$WORK_DIR/configs/fs_config-system"
            LOG_STEP_OUT
        fi
    fi
}

COPY_TARGET_FIRMWARE()
{
    local TARGET_FOLDERS="odm_dlkm system_dlkm vendor vendor_dlkm"
    for f in $TARGET_FOLDERS; do
        if [ -d "$FW_DIR/$TARGET_FIRMWARE_PATH/$f" ]; then
            LOG "- Copying /$f from target firmware"
            EVAL "rsync -a --mkpath --delete \"$FW_DIR/$TARGET_FIRMWARE_PATH/$f\" \"$WORK_DIR\"" || exit 1
            EVAL "cp -a \"$FW_DIR/$TARGET_FIRMWARE_PATH/file_context-$f\" \"$WORK_DIR/configs/file_context-$f\"" || exit 1
            EVAL "cp -a \"$FW_DIR/$TARGET_FIRMWARE_PATH/fs_config-$f\" \"$WORK_DIR/configs/fs_config-$f\"" || exit 1
            if [[ "$f" == "vendor" ]]; then
                LOG_STEP_IN
                SET_PROP "vendor" "ro.config.ringtone" "$(GET_PROP "$FW_DIR/$SOURCE_FIRMWARE_PATH/vendor/build.prop" "ro.config.ringtone")"
                SET_PROP "vendor" "ro.config.notification_sound" "$(GET_PROP "$FW_DIR/$SOURCE_FIRMWARE_PATH/vendor/build.prop" "ro.config.notification_sound")"
                SET_PROP "vendor" "ro.config.alarm_alert" "$(GET_PROP "$FW_DIR/$SOURCE_FIRMWARE_PATH/vendor/build.prop" "ro.config.alarm_alert")"
                SET_PROP "vendor" "ro.config.media_sound" "$(GET_PROP "$FW_DIR/$SOURCE_FIRMWARE_PATH/vendor/build.prop" "ro.config.media_sound")"
                SET_PROP "vendor" "ro.config.ringtone_2" "$(GET_PROP "$FW_DIR/$SOURCE_FIRMWARE_PATH/vendor/build.prop" "ro.config.ringtone_2")"
                SET_PROP "vendor" "ro.config.notification_sound_2" "$(GET_PROP "$FW_DIR/$SOURCE_FIRMWARE_PATH/vendor/build.prop" "ro.config.notification_sound_2")"
                LOG_STEP_OUT
            fi
        else
            [ -d "$WORK_DIR/$f" ] && rm -rf "${WORK_DIR:?}/$f"
            [ -f "$WORK_DIR/configs/file_context-$f" ] && rm -f "$WORK_DIR/configs/file_context-$f"
            [ -f "$WORK_DIR/configs/fs_config-$f" ] && rm -f "$WORK_DIR/configs/fs_config-$f"
        fi
    done
}

COPY_EXTRA_PARTITIONS()
{
    local WORK_DIR_ABS="$(cd "$WORK_DIR" && pwd)"

    # 1. Берем ODM из Target (там правильные драйверы и железо)
    if [ -d "$FW_DIR/$TARGET_FIRMWARE_PATH/odm" ]; then
        LOG "- Copying /odm from target firmware"
        EVAL "rsync -a --mkpath --delete \"$FW_DIR/$TARGET_FIRMWARE_PATH/odm\" \"$WORK_DIR_ABS\"" || exit 1
        EVAL "cp -a \"$FW_DIR/$TARGET_FIRMWARE_PATH/file_context-odm\" \"$WORK_DIR_ABS/configs/\"" || exit 1
        EVAL "cp -a \"$FW_DIR/$TARGET_FIRMWARE_PATH/fs_config-odm\" \"$WORK_DIR_ABS/configs/\"" || exit 1
    fi

    # 2. Берем PRISM из Source (оригинальные конфиги)
    if [ -d "$FW_DIR/$SOURCE_FIRMWARE_PATH/prism" ]; then
        LOG "- Copying /prism from source firmware"
        EVAL "rsync -a --mkpath --delete \"$FW_DIR/$SOURCE_FIRMWARE_PATH/prism\" \"$WORK_DIR_ABS\"" || exit 1
        EVAL "cp -a \"$FW_DIR/$SOURCE_FIRMWARE_PATH/file_context-prism\" \"$WORK_DIR_ABS/configs/\"" || exit 1
        EVAL "cp -a \"$FW_DIR/$SOURCE_FIRMWARE_PATH/fs_config-prism\" \"$WORK_DIR_ABS/configs/\"" || exit 1
    fi

    # 3. Берем OPTICS из Source (оригинальные конфиги)
    if [ -d "$FW_DIR/$SOURCE_FIRMWARE_PATH/optics" ]; then
        LOG "- Copying /optics from source firmware"
        EVAL "rsync -a --mkpath --delete \"$FW_DIR/$SOURCE_FIRMWARE_PATH/optics\" \"$WORK_DIR_ABS\"" || exit 1
        EVAL "cp -a \"$FW_DIR/$SOURCE_FIRMWARE_PATH/file_context-optics\" \"$WORK_DIR_ABS/configs/\"" || exit 1
        EVAL "cp -a \"$FW_DIR/$SOURCE_FIRMWARE_PATH/fs_config-optics\" \"$WORK_DIR_ABS/configs/\"" || exit 1
    fi
}

PATCH_RECOVERY_FSTAB()
{
    local RECOVERY_IMG="$WORK_DIR/kernel/recovery.img"
    local TMP_REC="$WORK_DIR/kernel/.rec_check"

    [ -f "$RECOVERY_IMG" ] || return 0
    LOG "- Patching fstab in recovery.img"
    rm -rf "$TMP_REC"
    mkdir -p "$TMP_REC"
    cd "$TMP_REC"

    EVAL "abootimg -x \"$RECOVERY_IMG\"" || { LOGE "abootimg -x failed"; cd -; return 1; }
    mkdir -p ramdisk
    cd ramdisk
    EVAL "zcat ../initrd.img | cpio -idmv --quiet" || { LOGE "cpio extract failed"; cd -; return 1; }

    cat > fstab.exynos9820 <<'EOF'
# Android fstab file.
#<src>                  <mnt_point>         <type>    <mnt_flags and options>                               <fs_mgr_flags>
/dev/block/by-name/system        /system             ext4      ro                                                    wait
/dev/block/by-name/vendor        /vendor             ext4      ro                                                    wait
/dev/block/by-name/product       /product            ext4      ro                                                    wait
/dev/block/by-name/odm           /odm                ext4      ro                                                    wait
/dev/block/by-name/cache         /cache              ext4      noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic    wait,check
/dev/block/by-name/userdata      /data               f2fs      noatime,nosuid,nodev,discard,usrquota,grpquota,fsync_mode=nobarrier,reserve_root=32768,resgid=5678    wait,check,quota,reservedsize=128M
/dev/block/by-name/efs           /mnt/vendor/efs     ext4      noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic    wait,check
/dev/block/by-name/misc          /misc               emmc      defaults                                              defaults
EOF

    EVAL "find . -mindepth 1 -print0 | cpio --null -o -H newc --quiet | gzip > ../initrd.img" || { LOGE "cpio repack failed"; cd -; return 1; }
    cd ..
    EVAL "abootimg --create \"$RECOVERY_IMG\" -f bootimg.cfg -k zImage -r initrd.img" || { LOGE "abootimg --create failed"; cd -; return 1; }
    if ! tail -c 16 "$RECOVERY_IMG" | grep -q "SEANDROIDENFORCE"; then
        echo -n "SEANDROIDENFORCE" >> "$RECOVERY_IMG"
    fi
    cd - >/dev/null
    rm -rf "$TMP_REC"
    LOG "- recovery.img repacked with fstab.exynos9820"
}

# ОТКЛЮЧЕНО: Мы теперь прошиваем ODM, удалять его из fstab не нужно
REMOVE_ODM_FSTAB_ENTRY()
{
    return 0
}

GENERATE_FIRST_STAGE_FSTAB()
{
    local HW="$1"
    local OUT_FILE="$2"
    local VENDOR_FSTAB=""

    for f in "$WORK_DIR"/vendor/etc/fstab.*; do
        [ -f "$f" ] && { VENDOR_FSTAB="$f"; break; }
    done

    if [ -n "$VENDOR_FSTAB" ]; then
        awk -v dyn="$TARGET_USE_DYNAMIC_PARTITIONS" -v fsys="$TARGET_OS_FILE_SYSTEM_TYPE" '
            /^#/ || NF == 0 { print; next }
            {
                src = $1; mnt = $2; type = $3; mntflags = $4; fsmgr = $5;
                
                # Обрабатываем ODM, PRISM, OPTICS наравне с основными разделами
                if (mnt == "/odm" || mnt == "/prism" || mnt == "/optics" || mnt == "/system" || mnt == "/vendor" || mnt == "/product" || mnt == "/system_ext") {
                    name = mnt; sub("^/", "", name);
                    if (dyn == "true") src = "/dev/block/mapper/" name;
                    else               src = "/dev/block/by-name/" name;
                    
                    if (mnt == "/prism" || mnt == "/optics") type = "ext4";
                    else type = fsys;

                    if (fsmgr !~ /first_stage_mount/) fsmgr = fsmgr ",first_stage_mount";
                    if (dyn == "true" && fsmgr !~ /logical/) fsmgr = fsmgr ",logical";
                    if (fsmgr !~ /(^|,)wait(,|$)/) fsmgr = "wait," fsmgr;
                }
                print src "\t" mnt "\t" type "\t" mntflags "\t" fsmgr;
            }' "$VENDOR_FSTAB" > "$OUT_FILE" || return 1
    else
        cat > "$OUT_FILE" <<EOF
# Android fstab file.
/dev/block/by-name/system /system $TARGET_OS_FILE_SYSTEM_TYPE ro wait,first_stage_mount
/dev/block/by-name/vendor /vendor $TARGET_OS_FILE_SYSTEM_TYPE ro wait,first_stage_mount
/dev/block/by-name/odm /odm $TARGET_OS_FILE_SYSTEM_TYPE ro wait,first_stage_mount
/dev/block/by-name/cache /cache ext4 noatime,nosuid,nodev wait,check
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev wait,check
/dev/block/by-name/misc /misc emmc defaults defaults
EOF
    fi
}

PATCH_BOOT_FSTAB()
{
    local BOOT_IMG="$WORK_DIR/kernel/boot.img"
    [ -f "$BOOT_IMG" ] || return 0

    LOG "- Patching fstab in boot.img (first stage mount)"

    # ── Определяем, есть ли в boot.img ramdisk ──────────────────────────
    # У Samsung system-as-root (A-only, напр. Exynos 9820 / beyond1lte)
    # ramdisk_size == 0, и стандартный abootimg на таком образе падает.
    # Читаем ramdisk_size из заголовка boot image (смещение 0x10, LE, 4 байта).
    local RAMDISK_SIZE
    RAMDISK_SIZE="$(od -An -tu4 -j16 -N4 "$BOOT_IMG" | tr -d ' ')"
    if [ -z "$RAMDISK_SIZE" ] || [ "$RAMDISK_SIZE" = "0" ]; then
        LOG "- boot.img has no ramdisk (ramdisk_size=0); skipping fstab patch"
        LOG "- (fstab for first-stage mount is provided by vendor/etc/fstab.*)"

        # Если есть init_boot.img с ramdisk — можно было бы взять оттуда,
        # но для Samsung Exynos 9820 (beyond1lte) его нет. На всякий случай
        # проверяем и предупреждаем.
        if [ -f "$WORK_DIR/kernel/init_boot.img" ]; then
            local INIT_RD_SIZE
            INIT_RD_SIZE="$(od -An -tu4 -j16 -N4 "$WORK_DIR/kernel/init_boot.img" | tr -d ' ')"
            if [ -n "$INIT_RD_SIZE" ] && [ "$INIT_RD_SIZE" != "0" ]; then
                LOGW "- init_boot.img has a ramdisk, but boot.img path is used for first-stage mount on this device"
                LOGW "- Not patching init_boot.img fstab (unsupported in this port)"
            fi
        fi
        return 0
    fi

    # ── Далее — обычная логика для образов С ramdisk ─────────────────────
    local TMP_BLD="$WORK_DIR/kernel/.boot_check"
    rm -rf "$TMP_BLD"
    mkdir -p "$TMP_BLD"
    cd "$TMP_BLD"

    EVAL "abootimg -x \"$BOOT_IMG\"" || { LOGE "abootimg -x failed (boot)"; cd - > /dev/null; return 1; }

    local HW
    HW="$(grep -o 'androidboot.hardware=[^ ]*' bootimg.cfg | head -n 1 | cut -d '=' -f 2)"
    [ ! "$HW" ] && HW="exynos9820"

    [ -s initrd.img ] || { LOGE "abootimg reported non-zero ramdisk but initrd.img is empty"; cd - > /dev/null; return 1; }

    local MAGIC MODE
    MAGIC="$(xxd -p -l 4 initrd.img)"
    case "$MAGIC" in
        1f8b*) MODE="gzip" ;;
        02214c18*|04224d18*) MODE="lz4" ;;
        *) MODE="raw" ;;
    esac

    mkdir -p ramdisk
    (cd ramdisk
     case "$MODE" in
         gzip) zcat ../initrd.img | cpio -idm --quiet ;;
         lz4)  lz4cat ../initrd.img | cpio -idm --quiet ;;
         *)    cpio -idm --quiet < ../initrd.img ;;
     esac) || { LOGE "Ramdisk extract failed"; cd - > /dev/null; return 1; }

    find ramdisk -maxdepth 1 -name "fstab.*" -delete
    GENERATE_FIRST_STAGE_FSTAB "$HW" "$TMP_BLD/ramdisk/fstab.$HW" || { LOGE "Failed to generate fstab.$HW"; cd - > /dev/null; return 1; }

    (cd ramdisk && find . -mindepth 1 -print0 | cpio --null -o -H newc --quiet) > ramdisk.cpio || { LOGE "cpio repack failed"; cd - > /dev/null; return 1; }
    case "$MODE" in
        gzip) EVAL "gzip -9 -c ramdisk.cpio > initrd.img" || { cd - > /dev/null; return 1; } ;;
        lz4)  EVAL "lz4 -l -9 -c ramdisk.cpio > initrd.img" || { cd - > /dev/null; return 1; } ;;
        *)    mv ramdisk.cpio initrd.img ;;
    esac

    EVAL "abootimg --create \"$BOOT_IMG\" -f bootimg.cfg -k zImage -r initrd.img" || { LOGE "abootimg --create failed"; cd - > /dev/null; return 1; }

    if ! tail -c 16 "$BOOT_IMG" | grep -q "SEANDROIDENFORCE"; then
        printf 'SEANDROIDENFORCE' >> "$BOOT_IMG"
    fi

    cd - > /dev/null
    rm -rf "$TMP_BLD"
    LOG "- boot.img now ships fstab.$HW"
}

COPY_TARGET_KERNEL()
{
    if [ -d "$FW_DIR/$TARGET_FIRMWARE_PATH/kernel" ]; then
        LOG_STEP_IN "- Copying target firmware kernel images"
        EVAL "rsync -a --mkpath --delete \"$FW_DIR/$TARGET_FIRMWARE_PATH/kernel\" \"$WORK_DIR\"" || exit 1
        $TARGET_KEEP_ORIGINAL_SIGN || find "$WORK_DIR/kernel" -mindepth 1 -exec "$SRC_DIR/scripts/unsign_bin.sh" {} \;
        if ! $TARGET_KEEP_ORIGINAL_SIGN; then
            PATCH_BOOT_FSTAB || exit 1
        fi
        PATCH_RECOVERY_FSTAB || exit 1
        LOG_STEP_OUT
    else
        [ -d "$WORK_DIR/kernel" ] && rm -rf "$WORK_DIR/kernel"
    fi
}
# ]

mkdir -p "$WORK_DIR"
mkdir -p "$WORK_DIR/configs"
COPY_SOURCE_FIRMWARE
COPY_TARGET_FIRMWARE
COPY_TARGET_KERNEL
COPY_EXTRA_PARTITIONS
printf '%s' "$FIRMWARE_IDENTITY" > "$WORK_DIR/.firmware_identity"

exit 0